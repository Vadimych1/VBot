{    
    "robot_name": "robot1",

    "local_ip": "127.0.0.1",
    "local_port": 3000,
    "remote_ip": "127.0.0.1",
    "remote_port": 3000,
    
    "on_robot": [
        {
            "from_node": "ssmain",
            "from_field": "map",
            
            "to_node": "vslam",
            "to_field": "setmap"
        },

        {
            "from_node": "ssmain",
            "from_field": "task",
            
            "to_node": "vmain",
            "to_field": "task"
        }
    ],

    "on_server": [
        {
            "from_node": "vslam",
            "from_field": "map",

            "to_node": "ssmain",
            "to_field": "map"
        },

        {
            "from_node": "vslam",
            "from_field": "pos",

            "to_node": "ssmain",
            "to_field": "pos"
        },

        {
            "from_node": "vmain",
            "from_field": "taskdone",

            "to_node": "ssmain",
            "to_field": "taskdone"
        }
    ]
}