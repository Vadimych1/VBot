<?xml version="1.0"?>
<robot name="room">
    <material name="wall">
        <color rgba="0.3 0.3 0.6 0.2"/>
    </material>

    <link name="base">
        <inertial>
            <origin xyz="0.0 10.0 0.0" rpy="0.0 0.0 0.0"/>
            <mass value="100"/>
            <inertia ixx="0.0" ixy="0.0" ixz="0.0" iyy="0.0" iyz="0.0" izz="0.0"/>
        </inertial>

        <visual>
            <origin xyz="0.0 10.0 0.0" rpy="0.0 0.0 0.0"/>
            <geometry>
                <box size="30.0 0.2 2"/>
            </geometry>
            <material name="wall"/>
        </visual>
        
        <collision>
            <origin xyz="0.0 10.0 0.0" rpy="0.0 0.0 0.0"/>
            <geometry>
                <box size="30.0 0.2 2"/>
            </geometry>
        </collision>
    </link>

    
    <link name="wall2">
        <inertial>
            <origin xyz="15 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <mass value="100"/>
            <inertia ixx="0.0" ixy="0.0" ixz="0.0" iyy="0.0" iyz="0.0" izz="0.0"/>
        </inertial>

        <visual>
            <origin xyz="15.0 -5.0 0.0" rpy="0.0 0.0 0.0"/>
            <geometry>
                <box size="0.2 30 2"/>
            </geometry>
            <material name="wall"/>
        </visual>
        
        <collision>
            <origin xyz="15.0 -5.0 0.0" rpy="0.0 0.0 0.0"/>
            <geometry>
                <box size="0.2 30 2"/>
            </geometry>
        </collision>
    </link>
    <joint name="wall2_joint" type="fixed">
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        <parent link="base"/>
        <child link="wall2"/>
    </joint>

    <link name="wall3">
        <inertial>
            <origin xyz="-15.0 -5.0 0.0" rpy="0.0 0.0 0.0"/>
            <mass value="100"/>
            <inertia ixx="0.0" ixy="0.0" ixz="0.0" iyy="0.0" iyz="0.0" izz="0.0"/>
        </inertial>

        <visual>
            <origin xyz="-15.0 -5.0 0.0" rpy="0.0 0.0 0.0"/>
            <geometry>
                <box size="0.2 30 2"/>
            </geometry>
            <material name="wall"/>
        </visual>
        
        <collision>
            <origin xyz="-15.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <geometry>
                <box size="0.2 30 2"/>
            </geometry>
        </collision>
    </link>
    <joint name="wall3_joint" type="fixed">
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        <parent link="base"/>
        <child link="wall3"/>
    </joint>

    <link name="wall4">
        <inertial>
            <origin xyz="-5.5 -10 0.0" rpy="0.0 0.0 0.0"/>
            <mass value="100"/>
            <inertia ixx="0.0" ixy="0.0" ixz="0.0" iyy="0.0" iyz="0.0" izz="0.0"/>
        </inertial>

        <visual>
            <origin xyz="-5.5 -10 0.0" rpy="0.0 0.0 0.0"/>
            <geometry>
                <box size="19 0.2 2"/>
            </geometry>
            <material name="wall"/>
        </visual>
        
        <collision>
            <origin xyz="-5.5 -10 0.0" rpy="0.0 0.0 0.0"/>
            <geometry>
                <box size="16 0.2 2"/>
            </geometry>
        </collision>
    </link>
    <joint name="wall4_joint" type="fixed">
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        <parent link="wall3"/>
        <child link="wall4"/>
    </joint>

    
    <link name="wall5">
        <inertial>
            <origin xyz="12 -10 0.0" rpy="0.0 0.0 0.0"/>
            <mass value="100"/>
            <inertia ixx="0.0" ixy="0.0" ixz="0.0" iyy="0.0" iyz="0.0" izz="0.0"/>
        </inertial>

        <visual>
            <origin xyz="12 -10 0.0" rpy="0.0 0.0 0.0"/>
            <geometry>
                <box size="6 0.2 2"/>
            </geometry>
            <material name="wall"/>
        </visual>
        
        <collision>
            <origin xyz="12 -10 0.0" rpy="0.0 0.0 0.0"/>
            <geometry>
                <box size="6 0.2 2"/>
            </geometry>
        </collision>
    </link>
    <joint name="wall5_joint" type="fixed">
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        <parent link="wall2"/>
        <child link="wall5"/>
    </joint>

    <link name="wall6">
        <inertial>
            <origin xyz="0.0 10.0 0.0" rpy="0.0 0.0 0.0"/>
            <mass value="100"/>
            <inertia ixx="0.0" ixy="0.0" ixz="0.0" iyy="0.0" iyz="0.0" izz="0.0"/>
        </inertial>

        <visual>
            <origin xyz="0.0 -20.0 0.0" rpy="0.0 0.0 0.0"/>
            <geometry>
                <box size="30.0 0.2 2"/>
            </geometry>
            <material name="wall"/>
        </visual>
        
        <collision>
            <origin xyz="0.0 10.0 0.0" rpy="0.0 0.0 0.0"/>
            <geometry>
                <box size="30.0 0.2 2"/>
            </geometry>
        </collision>
    </link>
    <joint name="wall6_joint" type="fixed">
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        <parent link="wall3"/>
        <child link="wall6"/>
    </joint>
</robot>