    </link>
    <joint name="rwheel4_joint" type="continuous">
        <origin xyz="0.2 -0.9 -0.2"/>
        <parent link="right_wheels_link"/>
        <child link="rwheel4"/>
        <axis xyz="1.0 0.0 0.0"/>
    </joint>


    <link name="lwheel1">
