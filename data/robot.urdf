<?xml version="1.0"?>

<robot name="vbot">
    <material name="darkgray">
        <color rgba="0.2 0.2 0.2 1.0"/>
    </material>

    <material name="purple">
        <color rgba="0.4 0.0 0.4 1.0"/>
    </material>

    <link name="base_link">
        <inertial>
            <mass value="0.15"/>
            <inertia ixx="0.0" ixy="0.0" ixz="0.0" iyy="0.0" iyz="0.0" izz="0.0"/>
        </inertial>

        <visual>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <geometry>
                <box size="1.6 2.0 0.1"/>
            </geometry>
            <material name="darkgray"/>
        </visual>

        <collision>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <geometry>
                <box size="1.6 2.0 0.1"/>
            </geometry>
        </collision>
    </link>


    <link name="left_wheels_link">
        <inertial>
            <mass value="0.1"/>
            <inertia ixx="0.0" ixy="0.0" ixz="0.0" iyy="0.0" iyz="0.0" izz="0.0"/>
        </inertial>

        <visual>
            <geometry>
                <box size="0.1 2.4 0.6"/>
            </geometry>
            <origin xyz="0 0 0"/>
            <material name="darkgray"/>
        </visual>

        <collision>
            <geometry>
                <box size="0.1 2.4 0.6"/>
            </geometry>
            <origin xyz="0 0 0"/>
        </collision>
    </link>
    <joint name="base_to_right" type="fixed">
        <parent link="base_link"/>
        <child link="right_wheels_link"/>
        <origin xyz="0.8 0 -0.3"/>
    </joint>


    <link name="right_wheels_link">
        <inertial>
            <mass value="0.1"/>
            <inertia ixx="0.0" ixy="0.0" ixz="0.0" iyy="0.0" iyz="0.0" izz="0.0"/>
        </inertial>

        <visual>
            <geometry>
                <box size="0.1 2.4 0.6"/>
            </geometry>
            <origin xyz="0 0 0"/>
            <material name="darkgray"/>
        </visual>

        <collision>
            <geometry>
                <box size="0.1 2.4 0.6"/>
            </geometry>
            <origin xyz="0 0 0"/>
        </collision>
    </link>
    <joint name="base_to_left" type="fixed">
        <parent link="base_link"/>
        <child link="left_wheels_link"/>
        <origin xyz="-0.8 0 -0.3"/>
    </joint>

    <link name="rwheel1">
        <inertial>
            <origin xyz="0.0 0.0 0.0"/>
            <mass value="0.08"/>
            <inertia ixx="0.0" ixy="0.0" ixz="0.0" iyy="0.0" iyz="0.0" izz="0.0"/>
        </inertial>
        <visual>
            <origin xyz="0.0 0.0 0.0" rpy="0 1.57 0.0"/>
            <geometry>
                <cylinder radius="0.2" length="0.2"/>
            </geometry>
            <material name="purple"/>
        </visual>
        <collision>
            <origin xyz="0.0 0.0 0.0" rpy="0 1.57 0"/>
            <geometry>
                <cylinder radius="0.2" length="0.2"/>
            </geometry>
        </collision>
    </link>
    <joint name="rwheel1_joint" type="continuous">
        <origin xyz="0.2 0.9 -0.2"/>
        <parent link="right_wheels_link"/>
        <child link="rwheel1"/>
        <axis xyz="1.0 0.0 0.0"/>
    </joint>

    <link name="rwheel2">
        <inertial>
            <origin xyz="0.0 0.0 0.0"/>
            <mass value="0.08"/>
            <inertia ixx="0.0" ixy="0.0" ixz="0.0" iyy="0.0" iyz="0.0" izz="0.0"/>
        </inertial>
        <visual>
            <origin xyz="0.0 0.0 0.0" rpy="0 1.57 0.0"/>
            <geometry>
