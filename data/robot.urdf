            <geometry>
                <cylinder radius="0.2" length="0.2"/>
            </geometry>
        </collision>
    </link>
    <joint name="rwheel3_joint" type="continuous">
        <origin xyz="0.2 -0.3 -0.2"/>
        <parent link="right_wheels_link"/>
        <child link="rwheel3"/>
        <axis xyz="1.0 0.0 0.0"/>
    </joint>

    <link name="rwheel4">
        <inertial>
            <origin xyz="0.0 0.0 0.0"/>
            <mass value="0.08"/>
            <inertia ixx="0.0" ixy="0.0" ixz="0.0" iyy="0.0" iyz="0.0" izz="0.0"/>
