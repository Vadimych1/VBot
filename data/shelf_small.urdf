<?xml version="1.0"?>
<robot name="shelf">
    <material name="gray">
        <color rgba="0.2 0.2 0.2 1.0"/>
    </material>

    <link name="base">
        <inertial>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <mass value="40"/>
            <inertia ixx="0.0" ixy="0.0" ixz="0.0" iyy="0.0" iyz="0.0" izz="0.0"/>
        </inertial>

        <visual>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <geometry>
                <box size="5 1 0.1"/>
            </geometry>
            <material name="gray"/>
        </visual>

        <collision>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <geometry>
                <box size="5 1 0.1"/>
            </geometry>
        </collision>
    </link>

    <link name="left_side">
        <inertial>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <mass value="20"/>
            <inertia ixx="0.0" ixy="0.0" ixz="0.0" iyy="0.0" iyz="0.0" izz="0.0"/>
        </inertial>

        <visual>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <geometry>
                <box size="0.15 1 1"/>
            </geometry>
            <material name="gray"/>
        </visual>
        
        <collision>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <geometry>
                <box size="0.15 1 1"/>
            </geometry>
        </collision>
    </link>
    <joint name="left_side_joint" type="fixed">
        <origin xyz="-2.575 0.0 0.45" rpy="0.0 0.0 0.0"/>
        <parent link="base"/>
        <child link="left_side"/>
    </joint>

    <link name="right_side">
        <inertial>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <mass value="20"/>
            <inertia ixx="0.0" ixy="0.0" ixz="0.0" iyy="0.0" iyz="0.0" izz="0.0"/>
        </inertial>

        <visual>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <geometry>
                <box size="0.15 1 1"/>
            </geometry>
            <material name="gray"/>
        </visual>
        
        <collision>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <geometry>
                <box size="0.15 1 1"/>
            </geometry>
        </collision>
    </link>
    <joint name="right_side_joint" type="fixed">
        <origin xyz="2.575 0.0 0.45" rpy="0.0 0.0 0.0"/>
        <parent link="base"/>
        <child link="right_side"/>
    </joint>

    <link name="shelf">
        <inertial>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <mass value="40"/>
            <inertia ixx="0.0" ixy="0.0" ixz="0.0" iyy="0.0" iyz="0.0" izz="0.0"/>
        </inertial>

        <visual>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <geometry>
                <box size="5 1 0.1"/>
            </geometry>
            <material name="blue">
                <color rgba="1.0 0.3 0.3 1.0"/>
            </material>
        </visual>

        <collision>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <geometry>
                <box size="5 1 0.1"/>
            </geometry>
        </collision>
    </link>
    <joint name="shelf_joint" type="fixed">
        <origin xyz="2.575 0.0 0.0" rpy="0.0 0.0 0.0"/>
        <parent link="left_side"/>
        <child link="shelf"/>
    </joint>

    <link name="back">
        <inertial>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <mass value="40"/>
            <inertia ixx="0.0" ixy="0.0" ixz="0.0" iyy="0.0" iyz="0.0" izz="0.0"/>
        </inertial>

        <visual>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <geometry>
                <box size="5.3 0.1 1"/>
            </geometry>
            <material name="gray"/>
        </visual>

        <collision>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <geometry>
                <box size="5.3 0.1 1"/>
            </geometry>
        </collision>
    </link>
    <joint name="back_joint" type="fixed">
        <origin xyz="0.0 -0.55 0.0" rpy="0.0 0.0 0.0"/>
        <parent link="shelf"/>
        <child link="back"/>
    </joint>
</robot>